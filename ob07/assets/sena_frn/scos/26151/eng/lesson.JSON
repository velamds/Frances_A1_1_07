ivity 1", "type": "group_name"}]}, {"content": {"correct_feedback": "Parfait !", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Quelque chose ne va pas. Essayez encore une fois !", "type": "text"}, {"content": "La prochaine fois peut-\u00eatre.", "type": "text"}], "allowed_attempts": 2}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Consignes : \u00c9coutez le dialogue encore une fois. D\u00e9placez les phrases dans les cases verticalement <span class=\"sena-icon sena-icon-vertical-drag\"></span> pour les faire r\u00e9pondre aux suggestions publicitaires.", "type": "text"}, {"content": "Vous avez deux essais pour soumettre vos r\u00e9ponses.", "type": "text"}, {"content": "frn2le07ob07re2aud01", "type": "audio"}]}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Listening", "type": "skill"}]}], "type": "MT1", "questions": [{"_data": [{"type": "question", "contents": [{"content": "Vous aimez les marques de luxe ?", "type": "text"}]}, {"content": "secondary_1", "type": "objective"}], "id": 0, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "Vous \u00eates au bon endroit ! Il y a de tout pour tout le monde ici !", "type": "text"}], "selected": 0}]}, {"_data": [{"type": "question", "contents": [{"content": "Il vous faut des sandales ou des baskets ?", "type": "text"}]}, {"content": "secondary_1", "type": "objective"}], "id": 1, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "Nos chaussures en solde sont bon march\u00e9 !", "type": "text"}], "selected": 0}]}, {"_data": [{"type": "question", "contents": [{"content": "Avez-vous besoin d'une nouvelle jupe ?", "type": "text"}]}, {"content": "secondary_1", "type": "objective"}], "id":