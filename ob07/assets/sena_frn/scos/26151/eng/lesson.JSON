ntent": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}]}]}, {"id": 11, "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": [{"content": "\u00c9crivons une pub pour un magasin de mode !", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Consignes : Compl\u00e9tez les \u00e9tapes suivantes. Remplissez la grille d'auto-\u00e9valuation.", "type": "text"}]}], "type": "DWS", "questions": [{"_data": [{"type": "question", "contents": [{"content": "frn2le07ob07re7pdf01.pdf", "type": "pdf"}]}], "id": 0, "responses": [{"correct": 1, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}]}]}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "id": 0, "template_override": 1}, {"id": 2, "contents": [{"value": {"audiosrc": "frn2le07ob07re2aud01", "images": [{"image": "frn2le07ob07re2img05.jpg", "id": 0, "text": "", "time": "0"}, {"image": "frn2le07ob07re2img05.jpg", "id": 1, "text": "<span class = \"strong\">L'agent de publicit\u00e9</span> : Bonjour, madame - monsieur ! Comment allez-vous ? Puis-je vous retenir une petite minute ? Vous \u00eates des clients r\u00e9guliers, n'est-ce pas ?<br/>\n<span class = \"strong\">Jean</span> : Euh... d\u00e9sol\u00e9, pas vraiment, c'est-\u00e0-dire pas du tout !<br/>\n<span class = \"strong\">L'agent de publicit\u00e9</span> : Bien s\u00fbr que vous l'\u00eates ! Vous ne le savez tout simplement pas ! Moi, par contre, je sais que vous \u00eates \u00e0 la recherche des soldes ! Et ce sont les soldes aux Vincennes, votre nouveau magasin de mode. Ne manquez pas cette opportunit\u00e9 ! Allez-y \u00e0 tout prix !<br/>", "time": "10"}, {"image": "frn2le07ob07re2img01.jpg", "id": 2, "text": "<span class = \"strong\">Jean</span> : Les Vincennes ? Mais c'est un magasin tr\u00e8s cher !<br/>\n<span class = \"strong\">L'agent de publicit\u00e9</span> : Pas du tout, monsieur ! Les Vincennes sont bon march\u00e9. Allez-y voir&nbsp;!<br/>\n<span class = \"strong\">Charlotte</span> : O\u00f9 est le magasin ?<br/>\n<span class = \"strong\">L'agent de publicit\u00e9</span> :  Continuez tout droit et tournez \u00e0 gauche au deuxi\u00e8me feu. Tenez, prenez ce d\u00e9pliant !", "time": "26000"}, {"image": "frn2le07ob07re2img01.jpg", "id": 3, "text": "<span class = \"strong\">Charlotte</span> : Avez-vous besoin d'une nouvelle robe ? Ne cherchez pas plus loin ! Aux Vincennes, vous pouvez choisir parmi une grande vari\u00e9t\u00e9 de tailles, prix et couleurs. Des robes taille 34 ou 52, \u00e0 29,99 \u20ac ou 99,99 \u20ac, jaunes, noires ou violet \u2013 tout y est ! Il vous faut une nouvelle paire de sandales ou de baskets ? Pas de probl\u00e8me ! Nos chaussures en solde co\u00fbtent de 19,50 \u00e0 85,00 \u20ac. \u00c9conomisez jusqu'\u00e0 100 \u20ac sur les vestes homme ! Ou peut-\u00eatre, adorez-vous les marques de luxe ? Vous \u00eates au bon endroit ! Il y a de tout pour tout le monde aux Vincennes ! Venez-y ! Arrivez t\u00f4t pour nos soldes d'ouverture ! On compte sur vous !", "time": "39800"}], "coverimg": "frn2le07ob07re2img05.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "title": ""}, {"id": 3, "contents": [{"value": "<span class = \"strong\">Marketer</span>:  Heellloooo there!  You look like great shoppers.  Am I right?<br/>\n<span class = \"strong\">John</span>:  Well, not really.<br/>\n<span class = \"strong\">Marketer</span>:  Of course you are.  Are you looking for a bargain? Don't miss out! It's sale time at Hampton's, your new store for fashion! <br/>\n<span class = \"strong\">John</span>: Hampton's? That's an expensive store.<br/>\n<span class = \"strong\">Marketer</span>: Not at all, honey! It's cheap!<br/>\n<span class = \"strong\">Sally</span>:  Where is the store?<br/>\n<span class = \"strong\">Marketer</span>:  Just go down here and make a left at the second street.  Here, take this flyer!\n<span class = \"strong\">Sally</span>: Need to buy a new dress? Choose from a wide selection, all sizes, $29.99 to $99.99, in all colors from yellow to black. Looking for sandals and sneakers? They're priced from $19.50 to $85.00. Save $100 on men's coats. Love designer labels? There is something for everyone!  Arrive early for opening specials. See you there!", "type": "p"}], "template_override": 1, "_data": [], "type": "stm", "title": ""}, {"id": 4, "contents": [{"value": "Need to buy a new dress? Choose from a wide selection, all sizes, $29.99 to $99.99, in all colors from yellow to black. Looking for sandals and sneakers? They're priced from $19.50 to $85.00. Save $100 on men's coats. Love designer labels? There is something for everyone!  Arrive early for opening specials. See you there!", "type": "p"}], "template_override": 1, "_data": [], "type": "static", "title": ""}], "id": 0, "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}]}